#!/usr/bin/env bash
# =============================================================================
# dev-forge : Host Resource Auto-Detection & VM Dimensioning (Bash)
# Directives: 50% Physical Cores (min 2), 33% Host RAM (min 4GB, 16GB->5GB),
#             Fastest Storage Directory, Dynamic Keyboard Synchronization.
# =============================================================================
set -e

FORGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
USER_FORGE_DIR="${FORGE_USER_CONFIG_DIR:-$HOME/.dev-forge}"
PROFILE_PATH="$USER_FORGE_DIR/forge-host.env"
mkdir -p "$USER_FORGE_DIR"

# Colores y Formato
BOLD="\e[1m"
RESET="\e[0m"
CYAN="\e[36m"
GREEN="\e[32m"
YELLOW="\e[33m"
RED="\e[31m"
GRAY="\e[90m"

log_info()  { echo -e "${CYAN}[forge-tune]${RESET} $1"; }
log_ok()    { echo -e "${GREEN}[forge-tune : OK]${RESET} $1"; }
log_warn()  { echo -e "${YELLOW}[forge-tune : AVISO]${RESET} $1"; }
log_err()   { echo -e "${RED}[forge-tune : ERROR]${RESET} $1" >&2; }

echo -e "${CYAN}${BOLD}"
echo "  ================================================================"
echo "         dev-forge : Dimensionador Automático de Recursos"
echo "  ================================================================"
echo -e "${RESET}"

# 1. Detección de Sistema Operativo Anfitrión
OS="$(uname -s)"
log_info "Detectando recursos del host en plataforma: ${BOLD}$OS${RESET}..."

CPU_MODEL=""
PHYS_CORES=2
TOTAL_RAM_GB=16
SMT_ACTIVE="OFF"

if [ "$OS" = "Linux" ]; then
    if command -v lscpu >/dev/null 2>&1; then
        CPU_MODEL="$(lscpu | grep -iE '(Model name|Nombre del modelo):' | cut -d: -f2 | sed 's/^[ \t]*//' | head -n 1)"
        PHYS_CORES="$(lscpu -p=CORE 2>/dev/null | grep -v '^#' | sort -u | wc -l)"
        LOGICAL_CORES="$(nproc)"
        [ "$LOGICAL_CORES" -gt "$PHYS_CORES" ] && SMT_ACTIVE="ON"
    else
        CPU_MODEL="$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^[ \t]*//')"
        PHYS_CORES="$(grep -m1 'cpu cores' /proc/cpuinfo | awk '{print $4}')"
    fi
    if [ -z "$CPU_MODEL" ] && [ -f /proc/cpuinfo ]; then
        CPU_MODEL="$(grep -m1 -i 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^[ \t]*//')"
    fi

    if [ -f /proc/meminfo ]; then
        TOTAL_RAM_KB="$(grep MemTotal /proc/meminfo | awk '{print $2}')"
        TOTAL_RAM_GB=$(( (TOTAL_RAM_KB + 1048575) / 1048576 ))
    fi

elif [ "$OS" = "Darwin" ]; then
    CPU_MODEL="$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo "Apple Silicon")"
    PHYS_CORES="$(sysctl -n hw.physicalcpu 2>/dev/null || echo 4)"
    LOGICAL_CORES="$(sysctl -n hw.logicalcpu 2>/dev/null || echo 8)"
    [ "$LOGICAL_CORES" -gt "$PHYS_CORES" ] && SMT_ACTIVE="ON"
    MEM_BYTES="$(sysctl -n hw.memsize 2>/dev/null || echo 17179869184)"
    TOTAL_RAM_GB=$(( MEM_BYTES / 1073741824 ))
fi

[ -z "$PHYS_CORES" ] || [ "$PHYS_CORES" -lt 1 ] && PHYS_CORES=2
[ -z "$CPU_MODEL" ] && CPU_MODEL="Generic x86_64 Processor"

# 2. Cálculo de vCPUs (Directiva: 50% de los núcleos físicos, mínimo 2)
if [ "$PHYS_CORES" -ge 4 ]; then
    CALC_VCPUS=$(( PHYS_CORES / 2 ))
else
    CALC_VCPUS=2
fi

# 3. Cálculo de RAM (Directiva: 33% de la RAM del host, min 4GB; caso 16GB -> 5120MB)
if [ "$TOTAL_RAM_GB" -ge 14 ] && [ "$TOTAL_RAM_GB" -le 20 ]; then
    CALC_RAM_MB=5120
else
    CALC_RAM_GB=$(( TOTAL_RAM_GB * 33 / 100 ))
    [ "$CALC_RAM_GB" -lt 4 ] && CALC_RAM_GB=4
    CALC_RAM_MB=$(( CALC_RAM_GB * 1024 ))
fi

# 4. Detección y Selección de Almacenamiento Óptimo para VirtualBox
VBOX_FOLDER=""
if [ -d "/mnt/data" ] && [ -w "/mnt/data" ]; then
    VBOX_FOLDER="/mnt/data/virtualbox"
elif [ -n "$HOME" ] && [ -d "$HOME" ]; then
    VBOX_FOLDER="$HOME/VirtualBox VMs"
else
    VBOX_FOLDER="/tmp/virtualbox"
fi
mkdir -p "$VBOX_FOLDER" 2>/dev/null || true

# Configurar carpeta predeterminada en VirtualBox si VBoxManage está disponible
if command -v VBoxManage >/dev/null 2>&1; then
    timeout 2 VBoxManage setproperty machinefolder "$VBOX_FOLDER" >/dev/null 2>&1 || true
fi

# 5. Detección del Teclado del Host
DETECTED_KB=""
if [ "$OS" = "Darwin" ]; then
    MAC_KB=$(defaults read ~/Library/Preferences/com.apple.HIToolbox.plist AppleSelectedInputSources 2>/dev/null | grep 'KeyboardLayout Name' | head -n 1 | awk -F'"' '{print $4}')
    case "${MAC_KB,,}" in
        *spanish*|*español*) DETECTED_KB="es" ;;
        *latin*|*latam*)     DETECTED_KB="latam" ;;
        *british*|*uk*)      DETECTED_KB="gb" ;;
        *french*)            DETECTED_KB="fr" ;;
        *german*)            DETECTED_KB="de" ;;
        *italian*)           DETECTED_KB="it" ;;
        *us*|*abc*)          DETECTED_KB="us" ;;
    esac
else
    if [ -f /etc/default/keyboard ]; then
        DETECTED_KB="$(grep '^XKBLAYOUT=' /etc/default/keyboard 2>/dev/null | cut -d'=' -f2 | sed "s/['\" ]//g")"
    fi
    if [ -z "$DETECTED_KB" ] && command -v localectl >/dev/null 2>&1; then
        DETECTED_KB="$(timeout 2 localectl status 2>/dev/null | awk '/X11 Layout/{print $3}')"
    fi
    if [ -z "$DETECTED_KB" ] || [ "$DETECTED_KB" = "n/a" ]; then
        DETECTED_KB="$(echo "${LANG:-es}" | cut -d'_' -f1 | tr '[:upper:]' '[:lower:]')"
    fi
fi
[ -z "$DETECTED_KB" ] && DETECTED_KB="es"

# 6. Generación del Archivo de Perfil config/forge-host.env
cat << EOF > "$PROFILE_PATH"
# =============================================================================
# dev-forge : Perfil de Recursos Dimensionados del Host
# Generado automáticamente por: dev-forge tune
# Fecha: $(date '+%Y-%m-%d %H:%M:%S')
# =============================================================================
FORGE_HOST_PROFILE_VERSION="1.0"
FORGE_HOST_OS="$OS"
FORGE_HOST_CPU_MODEL="$CPU_MODEL"
FORGE_HOST_PHYSICAL_CORES=$PHYS_CORES
FORGE_HOST_TOTAL_RAM_GB=$TOTAL_RAM_GB
FORGE_HOST_KEYBOARD="$DETECTED_KB"

# Asignación de Recursos para Máquinas Virtuales (Directivas de Arquitectura)
# - CPU: 50% de los núcleos físicos del host (min 2)
# - RAM: ~33% de la memoria física del host (min 4096 MB)
FORGE_LINUX_CPUS=$CALC_VCPUS
FORGE_LINUX_MEM=$CALC_RAM_MB
FORGE_WIN_CPUS=$CALC_VCPUS
FORGE_WIN_MEM=$CALC_RAM_MB

# Almacenamiento de Discos Virtuales en el Host
FORGE_VBOX_FOLDER="$VBOX_FOLDER"
EOF

# 7. Resumen de Dimensionamiento
echo -e "${BOLD}RECURSOS DEL HOST DETECTADOS:${RESET}"
echo -e "  - Procesador:        ${CYAN}$CPU_MODEL${RESET}"
echo -e "  - Núcleos Físicos:   ${CYAN}$PHYS_CORES${RESET} (SMT / HyperThreading: ${CYAN}$SMT_ACTIVE${RESET})"
echo -e "  - Memoria RAM Total: ${CYAN}${TOTAL_RAM_GB} GB${RESET}"
echo -e "  - Teclado Detectado: ${CYAN}$DETECTED_KB${RESET}"
echo -e "  - Carpeta Almacén:   ${CYAN}$VBOX_FOLDER${RESET}"
echo ""
echo -e "${BOLD}DIMENSIONAMIENTO APLICADO (Directivas dev-forge):${RESET}"
echo -e "  - vCPUs por VM:      ${GREEN}$CALC_VCPUS vCPUs${RESET} (50% de cores físicos, ejecución 100%)"
echo -e "  - RAM por VM:        ${GREEN}$CALC_RAM_MB MB (~$(( CALC_RAM_MB / 1024 )) GB)${RESET} (33% RAM host)"
echo -e "  - forge-linux:       ${GREEN}$CALC_VCPUS vCPUs / $CALC_RAM_MB MB${RESET} (KVM paravirt + virtio-net)"
echo -e "  - forge-windows:     ${GREEN}$CALC_VCPUS vCPUs / $CALC_RAM_MB MB${RESET} (Hyper-V paravirt + virtio-net)"
echo ""
log_ok "Perfil guardado con éxito en: ${BOLD}$PROFILE_PATH${RESET}"
log_ok "El entorno dev-forge está listo para compilar con rendimiento óptimo."
