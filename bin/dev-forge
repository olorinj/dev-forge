#!/usr/bin/env bash
# =============================================================================
# dev-forge : CLI Orquestador Multi-Lenguaje y Multiplataforma (100% Offline)
# =============================================================================
set -e

FORGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Colores y Formato
BOLD="\e[1m"
RESET="\e[0m"
CYAN="\e[36m"
GREEN="\e[32m"
YELLOW="\e[33m"
RED="\e[31m"
GRAY="\e[90m"

log_info()  { echo -e "${CYAN}[dev-forge]${RESET} $1"; }
log_ok()    { echo -e "${GREEN}[dev-forge : OK]${RESET} $1"; }
log_warn()  { echo -e "${YELLOW}[dev-forge : AVISO]${RESET} $1"; }
log_err()   { echo -e "${RED}[dev-forge : ERROR]${RESET} $1" >&2; }

print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ================================================================"
    echo "     ____  _______     __     _____ ___  ____   ____ _____ "
    echo "    |  _ \| ____\ \   / /    |  ___/ _ \|  _ \ / ___| ____|"
    echo "    | | | |  _|  \ \ / /_____| |_ | | | | |_) | |  _|  _|  "
    echo "    | |_| | |___  \ V /|_____|  _|| |_| |  _ <| |_| | |___ "
    echo "    |____/|_____|  \_/       |_|   \___/|_| \_\\____|_____|"
    echo "  ================================================================"
    echo -e "       Forja Universal de Compilación Multi-Lenguaje (100% Offline)${RESET}\n"
}

print_help() {
    print_banner
    echo -e "${BOLD}USO:${RESET}"
    echo "  dev-forge <comando> [opciones]"
    echo ""
    echo -e "${BOLD}COMANDOS:${RESET}"
    echo -e "  ${GREEN}build${RESET}      Compila un proyecto externo en las VMs correspondientes"
    echo -e "  ${GREEN}status${RESET}     Muestra el estado de las máquinas virtuales de la forja"
    echo -e "  ${GREEN}up${RESET}         Inicia una máquina virtual (forge-linux | forge-windows)"
    echo -e "  ${GREEN}halt${RESET}       Detiene las máquinas virtuales para liberar memoria"
    echo -e "  ${GREEN}provision${RESET}  Re-aprovisiona las herramientas en las máquinas virtuales"
    echo -e "  ${GREEN}ssh${RESET}        Abre una sesión interactiva en la VM (Linux)"
    echo ""
    echo -e "${BOLD}OPCIONES DE 'build':${RESET}"
    echo "  -p, --project <ruta>     Ruta al proyecto que se desea compilar (Obligatorio)"
    echo "  -t, --target <destino>   Destino: linux | windows | macos | android | all (defecto: all)"
    echo "  -c, --clean              Limpia cachés intermedias antes de compilar"
    echo "  -k, --keep-vm            Mantiene las VMs encendidas tras la compilación"
    echo "  -u, --update             Fuerza el re-aprovisionamiento de paquetes en la VM"
    echo "  -h, --help               Muestra esta ayuda"
    echo ""
    echo -e "${BOLD}EJEMPLOS:${RESET}"
    echo "  dev-forge build -p /home/user/DEV/rust/lexishield -t linux"
    echo "  dev-forge build -p /home/user/DEV/rust/lexishield -t windows"
    echo "  dev-forge build -p /home/user/DEV/mi-app-java -t android"
    echo "  dev-forge build -p /home/user/DEV/mi-script-py -t all"
    echo ""
}

# Detección del tipo de proyecto según sus ficheros
detect_project_type() {
    local p="$1"
    if [ -f "$p/Cargo.toml" ]; then
        if [ -d "$p/src-tauri" ] || [ -f "$p/src-tauri/tauri.conf.json" ]; then
            echo "rust-tauri"
        else
            echo "rust"
        fi
    elif [ -f "$p/build.gradle" ] || [ -f "$p/build.gradle.kts" ] || [ -f "$p/gradlew" ]; then
        if [ -d "$p/app/src/main" ] || grep -qi "com.android" "$p/build.gradle" 2>/dev/null; then
            echo "java-android"
        else
            echo "java"
        fi
    elif [ -f "$p/pyproject.toml" ] || [ -f "$p/requirements.txt" ] || [ -f "$p/main.py" ]; then
        echo "python"
    elif [ -f "$p/go.mod" ]; then
        echo "go"
    elif [ -f "$p/package.json" ]; then
        echo "node"
    elif [ -f "$p/CMakeLists.txt" ] || [ -f "$p/Makefile" ]; then
        echo "c-cpp"
    else
        echo "generic"
    fi
}

# Detección del teclado del host para replicarlo en las máquinas virtuales
detect_host_keyboard() {
    local layout=""
    if command -v localectl >/dev/null 2>&1; then
        layout=$(localectl status 2>/dev/null | awk '/X11 Layout/{print $3}')
    fi
    if [ -z "$layout" ] && [ -f /etc/default/keyboard ]; then
        layout=$(grep '^XKBLAYOUT=' /etc/default/keyboard 2>/dev/null | cut -d'=' -f2 | tr -d '"' | tr -d "'" | cut -d',' -f1)
    fi
    if [ -z "$layout" ] && command -v setxkbmap >/dev/null 2>&1; then
        layout=$(setxkbmap -query 2>/dev/null | awk '/layout/{print $2}' | cut -d',' -f1)
    fi
    # Soporte nativo para host macOS
    if [ -z "$layout" ] && command -v defaults >/dev/null 2>&1; then
        local mac_source
        mac_source=$(defaults read ~/Library/Preferences/com.apple.HIToolbox.plist AppleSelectedInputSources 2>/dev/null | grep 'KeyboardLayout Name' | head -n 1 | awk -F'"' '{print $4}')
        case "${mac_source,,}" in
            *spanish*|*español*) layout="es" ;;
            *latin*|*latam*)     layout="latam" ;;
            *british*|*uk*)      layout="gb" ;;
            *french*|*français*) layout="fr" ;;
            *german*|*deutsch*)  layout="de" ;;
            *italian*|*italiano*) layout="it" ;;
            *portuguese*)        layout="pt" ;;
            *u.s.*|*us*|*abc*)   layout="us" ;;
        esac
    fi
    if [ -z "$layout" ]; then
        layout=$(echo "${LANG:-es}" | cut -d'_' -f1 | tr '[:upper:]' '[:lower:]')
    fi
    echo "${layout:-es}"
}

cmd_provision() {
    local targets=("$@")
    if [ ${#targets[@]} -eq 0 ]; then
        targets=("forge-linux")
    elif [ "${targets[0]}" = "all" ]; then
        targets=("forge-linux" "forge-windows")
    fi

    for target in "${targets[@]}"; do
        local is_running=false
        if (cd "$FORGE_DIR" && vagrant status "$target" 2>/dev/null | grep -q "running"); then
            is_running=true
        fi

        if [ "$is_running" = true ]; then
            log_info "La máquina '$target' está encendida. Ejecutando reaprovisionamiento..."
            (cd "$FORGE_DIR" && vagrant provision "$target")
        else
            log_info "La máquina '$target' está apagada o no iniciada. Iniciando y aprovisionando automáticamente..."
            (cd "$FORGE_DIR" && vagrant up "$target" --provision)
        fi
    done
}

cmd_build() {
    local project_path=""
    local target="all"
    local do_clean=false
    local keep_vm=false
    local do_update=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            provision)
                shift
                cmd_provision "$@"
                return 0
                ;;
            -p|--project)
                project_path="$2"
                shift 2
                ;;
            -t|--target)
                target="$2"
                shift 2
                ;;
            -c|--clean)
                do_clean=true
                shift
                ;;
            -k|--keep-vm)
                keep_vm=true
                shift
                ;;
            -u|--update)
                do_update=true
                shift
                ;;
            -h|--help)
                print_help
                exit 0
                ;;
            *)
                log_err "Opción desconocida: $1"
                print_help
                exit 1
                ;;
        esac
    done

    if [ -z "$project_path" ]; then
        log_err "Debe especificar la ruta del proyecto con -p o --project."
        exit 1
    fi

    if [ ! -d "$project_path" ]; then
        log_err "El directorio de proyecto '$project_path' no existe."
        exit 1
    fi

    project_path="$(cd "$project_path" && pwd)"
    local project_name="$(basename "$project_path")"
    local project_type="$(detect_project_type "$project_path")"

    log_info "Proyecto objetivo: ${BOLD}${project_name}${RESET} ($project_path)"
    log_info "Tipo detectado:    ${BOLD}${project_type}${RESET}"
    log_info "Destino objetivo:  ${BOLD}${target}${RESET}"

    if [ -z "$FORGE_HOST_KEYBOARD" ]; then
        export FORGE_HOST_KEYBOARD="$(detect_host_keyboard)"
    fi
    log_info "Teclado host:      ${BOLD}${FORGE_HOST_KEYBOARD}${RESET}"

    # Asegurar carpeta dist en el proyecto cliente
    mkdir -p "$project_path/dist"

    export FORGE_WORKSPACE="$project_path"

    local need_linux=false
    local need_windows=false
    local need_macos=false

    case "$target" in
        linux)   need_linux=true ;;
        windows) need_windows=true ;;
        macos)   need_macos=true; need_linux=true ;;
        android) need_linux=true ;;
        all)     need_linux=true; need_windows=true; need_macos=true ;;
        *)
            log_err "Target no soportado: '$target'. Opciones: linux, windows, macos, android, all."
            exit 1
            ;;
    esac

    # 1. EJECUCIÓN EN FORGE-LINUX
    if [ "$need_linux" = true ]; then
        echo ""
        log_info "=== Preparando VM 'forge-linux' ==="
        if [ "$do_update" = true ]; then
            (cd "$FORGE_DIR" && vagrant up forge-linux --provision)
        else
            (cd "$FORGE_DIR" && vagrant up forge-linux)
        fi

        log_info "Ejecutando compilación en forge-linux (/workspace)..."
        local py_name="$project_name"
        [ "$project_name" = "python" ] && py_name="hashforge-py"
        local go_name="$project_name"
        [ "$project_name" = "go" ] && go_name="hashforge-go"

        case "$project_type" in
            rust-tauri)
                linux_cmd="cd /workspace && export CARGO_TARGET_DIR=/tmp/cargo-target && if [ -f ui/package.json ]; then npm --prefix ui run build; elif [ -f package.json ]; then npm run build; fi && cargo build --release && mkdir -p /workspace/dist && find /tmp/cargo-target/release -maxdepth 1 -type f \( -executable -o -name '*.so' -o -name '*.a' \) ! -name '*.d' -exec cp -f {} /workspace/dist/ \;"
                ;;
            rust)
                linux_cmd="cd /workspace && export CARGO_TARGET_DIR=/tmp/cargo-target && cargo build --release && mkdir -p /workspace/dist && find /tmp/cargo-target/release -maxdepth 1 -type f \( -executable -o -name '*.so' -o -name '*.a' \) ! -name '*.d' -exec cp -f {} /workspace/dist/ \;"
                ;;
            java-android)
                linux_cmd="cd /workspace && if [ -f ./gradlew ]; then chmod +x ./gradlew && (./gradlew assembleRelease || ./gradlew assembleDebug); else (gradle assembleRelease || gradle assembleDebug); fi && mkdir -p /workspace/dist && find app/build/outputs/apk -name '*.apk' -exec cp -f {} /workspace/dist/ \; 2>/dev/null || true"
                ;;
            java)
                linux_cmd="cd /workspace && if [ -f ./gradlew ]; then chmod +x ./gradlew && ./gradlew build; elif [ -f build.gradle ]; then gradle build; else mkdir -p build/classes /workspace/dist && javac -d build/classes \$(find src -name '*.java') && jar cfe /workspace/dist/hashforge-java.jar com.devforge.hashforge.Main -C build/classes . ; fi && mkdir -p /workspace/dist && find build/libs -name '*.jar' ! -name '*-plain.jar' -exec cp -f {} /workspace/dist/ \; 2>/dev/null || true"
                ;;
            python)
                linux_cmd="cd /workspace && if [ -f main.py ]; then pyinstaller --onefile --name \"$py_name\" --distpath /workspace/dist main.py; else python3 -m pip install -e .; fi"
                ;;
            go)
                linux_cmd="cd /workspace && mkdir -p /workspace/dist && go build -ldflags='-s -w' -o \"/workspace/dist/$go_name\" ./"
                ;;
            c-cpp)
                linux_cmd="cd /workspace && if [ -f CMakeLists.txt ]; then cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build && mkdir -p /workspace/dist && find build -maxdepth 2 -type f \( -executable -o -name '*.so' -o -name '*.a' \) ! -name '*.sh' ! -name '*.txt' ! -name '*.cmake' -exec cp -f {} /workspace/dist/ \;; elif [ -f Makefile ]; then make && mkdir -p /workspace/dist && find . -maxdepth 1 -type f -executable ! -name '*.sh' -exec cp -f {} /workspace/dist/ \;; fi"
                ;;
            *)
                linux_cmd="cd /workspace && if [ -f Makefile ]; then make; fi"
                ;;
        esac

        if [ "$do_clean" = true ]; then
            linux_cmd="cargo clean 2>/dev/null || true; $linux_cmd"
            linux_cmd="rm -rf /tmp/cargo-target /workspace/target 2>/dev/null || true; cargo clean 2>/dev/null || true; $linux_cmd"
        fi

        (cd "$FORGE_DIR" && vagrant ssh forge-linux -c "$linux_cmd")
        log_ok "Compilación en forge-linux finalizada."

        if [ "$need_macos" = true ]; then
            log_info "Ejecutando compilación cruzada para macOS vía Docker/osxcross en forge-linux..."
            local mac_cmd="cd /workspace && if [ -f Cargo.toml ]; then cargo build --release --target x86_64-apple-darwin 2>/dev/null || true; fi"
            local mac_cmd="cd /workspace && if [ -f Cargo.toml ]; then export CARGO_TARGET_DIR=/tmp/cargo-target && cargo build --release --target x86_64-apple-darwin 2>/dev/null && mkdir -p /workspace/dist && find /tmp/cargo-target/x86_64-apple-darwin/release -maxdepth 1 -type f ! -name '*.d' ! -name '*.rlib' -exec cp -f {} /workspace/dist/ \; || true; fi"
            (cd "$FORGE_DIR" && vagrant ssh forge-linux -c "$mac_cmd") || true
        fi

        if [ "$keep_vm" = false ]; then
            log_info "Deteniendo 'forge-linux' para liberar memoria..."
            (cd "$FORGE_DIR" && vagrant halt forge-linux)
        fi
    fi

    # 2. EJECUCIÓN EN FORGE-WINDOWS
    if [ "$need_windows" = true ]; then
        echo ""
        log_info "=== Preparando VM 'forge-windows' ==="
        if [ "$do_update" = true ]; then
            (cd "$FORGE_DIR" && vagrant up forge-windows --provision)
        else
            (cd "$FORGE_DIR" && vagrant up forge-windows)
        fi

        log_info "Ejecutando compilación nativa en forge-windows (c:\\workspace)..."
        local py_name="$project_name"
        [ "$project_name" = "python" ] && py_name="hashforge-py"
        local go_name="$project_name"
        [ "$project_name" = "go" ] && go_name="hashforge-go"

        local win_cmd=""
        case "$project_type" in
            rust-tauri)
                win_cmd="Set-Location c:\\workspace; [Environment]::SetEnvironmentVariable('CARGO_TARGET_DIR', 'c:\\target'); if (Test-Path ui\\package.json) { if (-not (Test-Path ui\\dist)) { if (-not (Test-Path ui\\node_modules\\.bin\\vite.cmd)) { npm --prefix ui install }; npm --prefix ui run build } } elseif (Test-Path package.json) { if (-not (Test-Path dist)) { if (-not (Test-Path node_modules)) { npm install }; npm run build } }; cargo build --release; if (Test-Path c:\\target\\release) { New-Item -ItemType Directory -Force -Path c:\\workspace\\dist | Out-Null; Get-ChildItem c:\\target\\release -Filter *.exe | Copy-Item -Destination c:\\workspace\\dist\\ -Force; Get-ChildItem c:\\target\\release -Filter *.dll | Copy-Item -Destination c:\\workspace\\dist\\ -Force }"
                ;;
            rust)
                win_cmd="Set-Location c:\\workspace; [Environment]::SetEnvironmentVariable('CARGO_TARGET_DIR', 'c:\\target'); cargo build --release; if (Test-Path c:\\target\\release) { New-Item -ItemType Directory -Force -Path c:\\workspace\\dist | Out-Null; Get-ChildItem c:\\target\\release -Filter *.exe | Copy-Item -Destination c:\\workspace\\dist\\ -Force; Get-ChildItem c:\\target\\release -Filter *.dll | Copy-Item -Destination c:\\workspace\\dist\\ -Force }"
                ;;
            java)
                win_cmd="Set-Location c:\\workspace; if (Test-Path gradlew.bat) { .\\gradlew.bat build } elseif (Test-Path build.gradle) { gradle build } else { New-Item -ItemType Directory -Force -Path build\\classes, c:\\workspace\\dist | Out-Null; javac -d build\\classes (Get-ChildItem -Recurse -Filter *.java src | ForEach-Object { \$_.FullName }); jar cfe c:\\workspace\\dist\\hashforge-java.jar com.devforge.hashforge.Main -C build\\classes . }; if (Test-Path build\\libs) { New-Item -ItemType Directory -Force -Path c:\\workspace\\dist | Out-Null; Get-ChildItem build\\libs -Filter *.jar | Where-Object { \$_.Name -notlike '*-plain.jar' } | Copy-Item -Destination c:\\workspace\\dist\\ -Force }"
                ;;
            java-android)
                win_cmd="Set-Location c:\\workspace; if (Test-Path gradlew.bat) { .\\gradlew.bat assembleRelease } else { gradle assembleRelease }; if (Test-Path app\\build\\outputs\\apk) { New-Item -ItemType Directory -Force -Path c:\\workspace\\dist | Out-Null; Get-ChildItem -Recurse app\\build\\outputs\\apk -Filter *.apk | Copy-Item -Destination c:\\workspace\\dist\\ -Force }"
                ;;
            python)
                win_cmd="Set-Location c:\\workspace; if (Test-Path main.py) { pyinstaller --onefile --name '$py_name' --distpath c:\\workspace\\dist main.py }"
                ;;
            go)
                win_cmd="Set-Location c:\\workspace; New-Item -ItemType Directory -Force -Path c:\\workspace\\dist | Out-Null; go build -ldflags=\"-s -w\" -o c:\\workspace\\dist\\$go_name.exe ./"
                ;;
            c-cpp)
                win_cmd="Set-Location c:\\workspace; if (Test-Path CMakeLists.txt) { cmake -B build; cmake --build build --config Release; if (Test-Path build\\Release) { New-Item -ItemType Directory -Force -Path c:\\workspace\\dist | Out-Null; Get-ChildItem build\\Release -Filter *.exe | Copy-Item -Destination c:\\workspace\\dist\\ -Force; Get-ChildItem build\\Release -Filter *.dll | Copy-Item -Destination c:\\workspace\\dist\\ -Force } elseif (Test-Path build) { New-Item -ItemType Directory -Force -Path c:\\workspace\\dist | Out-Null; Get-ChildItem build -Filter *.exe | Copy-Item -Destination c:\\workspace\\dist\\ -Force } } elseif (Test-Path Makefile) { nmake }"
                ;;
            *)
                win_cmd="Write-Host 'No se reconoció comando específico para este tipo en Windows.'"
                ;;
        esac

        if [ "$do_clean" = true ]; then
            win_cmd="if (Test-Path c:\\target) { Remove-Item -Recurse -Force c:\\target -ErrorAction SilentlyContinue }; if (Test-Path c:\\workspace\\target) { Remove-Item -Recurse -Force c:\\workspace\\target -ErrorAction SilentlyContinue }; $win_cmd"
        fi

        (cd "$FORGE_DIR" && vagrant winrm forge-windows -c "powershell -ExecutionPolicy Bypass -Command \"$win_cmd\"")
        log_ok "Compilación en forge-windows finalizada."

        if [ "$keep_vm" = false ]; then
            log_info "Deteniendo 'forge-windows' para liberar memoria..."
            (cd "$FORGE_DIR" && vagrant halt forge-windows)
        fi
    fi

    echo ""
    log_ok "Proceso completado con éxito. Revisa los binarios generados en: ${BOLD}$project_path/dist${RESET}"
    if [ -d "$project_path/dist" ]; then
        local count=0
        for f in "$project_path/dist"/*; do
            if [ -f "$f" ]; then
                ((count++))
            fi
        done
        if [ "$count" -gt 0 ]; then
            echo -e "\n  ${CYAN}${BOLD}Artefactos en dist/ ($count):${RESET}"
            for f in "$project_path/dist"/*; do
                if [ -f "$f" ]; then
                    local fname="$(basename "$f")"
                    local fsize="$(ls -lh "$f" | awk '{print $5}')"
                    printf "   ${GREEN}✔${RESET} %-40s ${GRAY}(%s)${RESET}\n" "$fname" "$fsize"
                fi
            done
            echo ""
        fi
    fi
}

# Enrutador principal de comandos
case "$1" in
    build)
        shift
        cmd_build "$@"
        ;;
    status)
        (cd "$FORGE_DIR" && vagrant status)
        ;;
    up)
        shift
        (cd "$FORGE_DIR" && vagrant up "$@")
        ;;
    halt)
        shift
        (cd "$FORGE_DIR" && vagrant halt "$@")
        ;;
    provision)
        shift
        cmd_provision "$@"
        ;;
    ssh)
        shift
        (cd "$FORGE_DIR" && vagrant ssh forge-linux "$@")
        ;;
    -h|--help|help|"")
        print_help
        ;;
    *)
        log_err "Comando no reconocido: '$1'"
        print_help
        exit 1
        ;;
esac

