#!/usr/bin/env bash
# =============================================================================
# dev-forge : Smart Bootstrap Wrapper (Delegates to Native Rust Orchestrator)
# =============================================================================
set -e

FORGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export FORGE_DIR
BIN_PATH="$FORGE_DIR/target/release/dev-forge"

# 1. Si existe el binario release compilado, ejecutarlo inmediatamente
if [ -x "$BIN_PATH" ]; then
    exec "$BIN_PATH" "$@"
fi

# 2. Si dev-forge está instalado globalmente en PATH, delegar en él
if command -v dev-forge >/dev/null 2>&1; then
    exec dev-forge "$@"
fi

# 3. Si cargo está disponible en el host, compilar automáticamente la primera vez
if command -v cargo >/dev/null 2>&1; then
    echo -e "\e[36m[dev-forge]\e[0m Compilando el binario nativo en Rust por primera vez..."
    (cd "$FORGE_DIR" && cargo build --release --bin dev-forge)
    if [ -x "$BIN_PATH" ]; then
        exec "$BIN_PATH" "$@"
    fi
fi

# 4. Si python3 está disponible, delegar transparentemente al motor Python
if command -v python3 >/dev/null 2>&1 && [ -f "$FORGE_DIR/dev-forge.py" ]; then
    exec python3 "$FORGE_DIR/dev-forge.py" "$@"
fi

# Si no hay binario ni cargo ni python3, mostrar instrucciones claras
echo -e "\e[31m[dev-forge : ERROR]\e[0m No se encontró el binario compilado 'dev-forge' ni Python 3." >&2
echo -e "Instala Rust (cargo) o ejecuta con: \e[1mpython3 dev-forge.py\e[0m" >&2
exit 1
