# =============================================================================
# dev-forge : Plantilla de Perfil de Recursos del Host
# Genera tu perfil real ejecutando: dev-forge tune (o .\bin\dev-forge.ps1 tune)
# =============================================================================
FORGE_HOST_PROFILE_VERSION="1.0"
FORGE_HOST_OS="Linux"
FORGE_HOST_CPU_MODEL="Intel / AMD x86_64 Processor"
FORGE_HOST_PHYSICAL_CORES=4
FORGE_HOST_TOTAL_RAM_GB=16
FORGE_HOST_KEYBOARD="es"

# Recursos Calculados (50% Cores físicos, 33% RAM total)
FORGE_LINUX_CPUS=2
FORGE_LINUX_MEM=5120
FORGE_WIN_CPUS=2
FORGE_WIN_MEM=5120

# Ubicación de Almacenamiento de VirtualBox
FORGE_VBOX_FOLDER="/mnt/data/virtualbox"
